# Canvas calendar feed (Canvas > Agenda > "Agenda-feed"). Keep this private: anyone with the URL can read your calendar.
ICAL_FEED_URL=https://YOUR-CANVAS-DOMAIN/feeds/calendars/user_XXXXXXXXXXXXXXXX.ics

# ntfy.sh topic. Pick something long and unguessable: anyone who knows the name can read your notifications.
NTFY_TOPIC=artevelde-tasks-change-me-8f3k2x9q

# How many days ahead to show / notify about
LOOKAHEAD_DAYS=14

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Port for local dev / Docker
PORT=5000

# --- Optional ---
# How often the feed is re-fetched and notifications are checked (minutes)
# REFRESH_INTERVAL_MINUTES=60
# Public URL of your deployment; used as the link in push notifications (Render sets this automatically)
# BASE_URL=https://artevelde-task-tracker.onrender.com
# Timezone used for due dates and "days until due"
# TIMEZONE=Europe/Brussels
# Also send a notification for tasks in the green (default) tier
# NOTIFY_DEFAULT_TIER=true
# Where sent notifications are tracked
# STATE_FILE=data/notifications.json
